<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ReplayMate.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ReplayMate.Views"
    Title="ReplayMate">

    <Grid x:Name="Root" RequestedTheme="Dark" Background="#0E1014">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Background="Transparent">
            <TextBlock Text="ReplayMate" Margin="16,0,0,0" VerticalAlignment="Center"
                       FontSize="12" Opacity="0.75" />
        </Grid>

        <InfoBar x:Name="TrayWarning" Grid.Row="1" IsOpen="False" IsClosable="True"
                 Severity="Warning" Margin="12,0,12,8" />

        <TabView x:Name="Tabs" Grid.Row="2" IsAddTabButtonVisible="False"
                 CanReorderTabs="False" CanDragTabs="False">
            <TabViewItem Header="游戏">
                <views:GamesPage x:Name="GamesView" />
            </TabViewItem>
            <TabViewItem Header="设置">
                <views:SettingsPage x:Name="SettingsView" />
            </TabViewItem>
            <TabViewItem Header="日志">
                <views:LogsPage x:Name="LogsView" />
            </TabViewItem>
        </TabView>
    </Grid>
</Window>
