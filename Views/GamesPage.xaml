<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ReplayMate.Views.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ReplayMate.Views">

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="添加运行中的游戏" Click="AddFromRunning_Click" />
            <Button Content="扫描 Steam / Epic" Click="ScanLibraries_Click" />
            <Button Content="移除选中" Click="RemoveSelected_Click" />
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="HintText" Opacity="0.6" FontSize="12"
                   Text="白名单里的游戏启动后会按设置的延迟自动开启即时重放；不在白名单里的程序不受影响。" />

        <ListView Grid.Row="2" x:Name="GameList" SelectionMode="Extended"
                  Background="Transparent" BorderThickness="0">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:GameRowVm">
                    <Grid ColumnSpacing="12" Padding="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox IsChecked="{x:Bind Enabled, Mode=TwoWay}" MinWidth="0"
                                  VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Match}" Opacity="0.55" FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{x:Bind Source}" Opacity="0.45"
                                   FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="2" x:Name="EmptyHint" Opacity="0.45"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="白名单还是空的。点上方按钮添加游戏。" Visibility="Collapsed" />
    </Grid>
</UserControl>
