<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ReplayMate.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="20">
        <StackPanel Spacing="18" MaxWidth="640" HorizontalAlignment="Left">

            <TextBlock Text="检测与延迟" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="以下改动即时生效，无需点保存。" Opacity="0.55" FontSize="12" />

            <StackPanel Spacing="6">
                <TextBlock Text="监听间隔（秒）" />
                <NumberBox x:Name="PollBox" Minimum="1" Maximum="60"
                           SpinButtonPlacementMode="Inline" Width="180"
                           ValueChanged="PollBox_ValueChanged" />
                <TextBlock Text="多久检查一次游戏是否在运行。越小反应越快，CPU 唤醒越多。"
                           Opacity="0.5" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="开启延迟（秒）" />
                <NumberBox x:Name="EnableDelayBox" Minimum="0" Maximum="300"
                           SpinButtonPlacementMode="Inline" Width="180"
                           ValueChanged="EnableDelayBox_ValueChanged" />
                <TextBlock Text="检测到游戏后等多久才开启即时重放。避免启动器/过场动画期间就开录。"
                           Opacity="0.5" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="关闭延迟（秒）" />
                <NumberBox x:Name="DisableDelayBox" Minimum="0" Maximum="600"
                           SpinButtonPlacementMode="Inline" Width="180"
                           ValueChanged="DisableDelayBox_ValueChanged" />
                <TextBlock Text="游戏退出后等多久才关闭即时重放。留出保存最后一段的时间。"
                           Opacity="0.5" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>

            <Rectangle Height="1" Fill="#22FFFFFF" />

            <TextBlock Text="启动与常驻" FontSize="16" FontWeight="SemiBold" />

            <ToggleSwitch x:Name="AutostartSwitch"
                          Header="开机静默自启（登录后隐藏到托盘）"
                          OnContent="已启用" OffContent="未启用"
                          Toggled="AutostartSwitch_Toggled" />

            <TextBlock x:Name="AutostartHint" Opacity="0.5" FontSize="12" TextWrapping="Wrap" />

            <Rectangle Height="1" Fill="#22FFFFFF" />

            <TextBlock Text="AMD 即时重放状态" FontSize="16" FontWeight="SemiBold" />

            <TextBlock x:Name="AmdStatusText" TextWrapping="Wrap" Opacity="0.85" />
            <TextBlock x:Name="CurrentStatusText" TextWrapping="Wrap" Opacity="0.6" FontSize="12" />

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="PauseButton" Content="暂停自动化" Click="Pause_Click"
                        Style="{StaticResource AccentButtonStyle}" />
                <Button Content="刷新 AMD 状态" Click="RefreshAmd_Click" />
            </StackPanel>

            <Rectangle Height="1" Fill="#22FFFFFF" />

            <TextBlock x:Name="AboutText" Opacity="0.45" FontSize="12" TextWrapping="Wrap" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
