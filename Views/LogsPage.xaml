<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ReplayMate.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="打开日志目录" Click="OpenFolder_Click" />
            <Button Content="刷新" Click="Refresh_Click" />
            <TextBlock Text="日志保留 48 小时，启动时自动清理。" Opacity="0.5"
                       FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>

        <ListView Grid.Row="1" x:Name="LogList" Background="#14000000"
                  FontFamily="Consolas" FontSize="12" SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="8,2" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</UserControl>
